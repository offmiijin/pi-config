{
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "extensions/*"
  ],
  "dependencies": {
    "@earendil-works/pi-tui": "^0.84.0",
    "@rolldown/binding-linux-x64-gnu": "^1.1.5"
  },
  "scripts": {
    "test": "npm run test:pi-sandbox && npm run test:github && npm run test:websearch && npm run test:document && npm run test:memory && npm run test:pi-doctor && npm run test:pi-changelog && npm run test:todo && npm run test:pi-panels && npm run test:pi-hooks && npm run test:pi-project-context && npm run test:pi-agent-type && npm run test:pi-status-bar",
    "test:pi-sandbox": "cd extensions/pi-sandbox && vitest run",
    "test:github": "cd extensions/pi-github && vitest run",
    "test:websearch": "cd extensions/pi-web-search && vitest run",
    "test:document": "npm run test --workspace=extensions/pi-document",
    "test:memory": "npm run test --workspace=extensions/pi-memory",
    "test:pi-changelog": "cd extensions/pi-changelog && vitest run",
    "test:todo": "cd extensions/pi-todo && vitest run",
    "test:pi-panels": "npm run test --workspace=extensions/pi-panels",
    "test:pi-hooks": "cd extensions/pi-hooks && vitest run",
    "test:pi-project-context": "cd extensions/pi-project-context && vitest run",
    "test:pi-agent-type": "cd extensions/pi-agent-type && vitest run",
    "test:pi-status-bar": "cd extensions/pi-status-bar && vitest run",
    "test:pi-doctor": "cd extensions/pi-doctor && vitest run tests/doctor.test.ts",
    "typecheck": "cd extensions/pi-sandbox && tsc --noEmit",
    "typecheck:pi-panels": "npm run typecheck --workspace=extensions/pi-panels",
    "doctor:check": "cd extensions/pi-doctor && vitest run tests/doctor.smoke.test.ts"
  }
}
