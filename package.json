{
  "private": true,
  "workspaces": [
    "extensions/*"
  ],
  "dependencies": {
    "@earendil-works/pi-tui": "^0.84.0",
    "@rolldown/binding-linux-x64-gnu": "^1.1.5"
  },
  "scripts": {
    "test": "npm run test:pi-sandbox && npm run test:github && npm run test:websearch && npm run test:memory && npm run test:pi-doctor && npm run test:pi-caveman && npm run test:pi-changelog && npm run test:todo && npm run test:pi-panel && npm run test:pi-token-monitor",
    "test:pi-sandbox": "cd extensions/pi-sandbox && vitest run",
    "test:github": "cd extensions/pi-github && vitest run",
    "test:websearch": "cd extensions/pi-web-search && vitest run",
    "test:memory": "cd extensions/pi-memory && node --test",
    "test:pi-changelog": "cd extensions/pi-changelog && vitest run",
    "test:todo": "cd extensions/pi-todo && vitest run",
    "test:pi-panel": "cd extensions/pi-panel && vitest run",
    "test:pi-token-monitor": "cd extensions/pi-token-monitor && vitest run",
    "test:pi-doctor": "cd extensions && vitest run tests/doctor.test.ts",
    "test:pi-caveman": "npm run typecheck --workspace=extensions/pi-caveman && npm run test --workspace=extensions/pi-caveman",
    "typecheck": "cd extensions/pi-sandbox && tsc --noEmit",
    "typecheck:pi-caveman": "npm run typecheck --workspace=extensions/pi-caveman",
    "doctor:check": "cd extensions && vitest run tests/doctor.smoke.test.ts"
  }
}
