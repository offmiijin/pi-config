{
  "enabled": true,
  "internet": {
    "enabled": true
  },
  "_warning_docker_sock": "NUNCA monte /var/run/docker.sock a menos que você entenda o risco: qualquer processo no sandbox pode usar o socket para ganhar acesso root ao host (ex: docker run -v /:/host --privileged).",
  "filesystem": {
    "extraWritable": [],
    "extraReadonly": [
      "/mnt/dados"
    ],
    "denyPaths": [
      "/sbin",
      "/usr/sbin",
      "/root"
    ],
    "denyFilePatterns": [".env", "*.pem", "*.key"],
    "cacheDirs": {
      "npm": "",
      "pip": "",
      "clones": ""
    },
    "quarantineDirs": {
      "fetch": "",
      "runs": ""
    }
  },
  "ssh": {
    "mode": "agent"
  },
  "capabilities": {
    "_doc": "Linux capabilities removidas do sandbox. Remova desta lista para reabilitar. As únicas mantidas são CAP_SYS_NICE (nice) e CAP_SYS_RESOURCE (ulimit).",
    "_reabilitar_exemplo": "Para usar gdb/strace, remova CAP_SYS_PTRACE desta lista.",
    "_bind_porta_80": "Para bind em porta <1024, remova CAP_NET_BIND_SERVICE.",
    "drop": [
      "CAP_SYS_ADMIN",
      "CAP_SYS_MODULE",
      "CAP_SYS_RAWIO",
      "CAP_SYS_BOOT",
      "CAP_SYSLOG",
      "CAP_BPF",
      "CAP_PERFMON",
      "CAP_SYS_PTRACE",
      "CAP_NET_ADMIN",
      "CAP_NET_RAW",
      "CAP_NET_BIND_SERVICE",
      "CAP_MKNOD",
      "CAP_SYS_CHROOT",
      "CAP_DAC_OVERRIDE",
      "CAP_FOWNER",
      "CAP_FSETID",
      "CAP_SETUID",
      "CAP_SETGID"
    ]
  },
  "seccomp": {
    "_doc": "Filtro seccomp: bloqueia syscalls perigosas no kernel. Use gen-seccomp (Rust) para gerar o .bpf.",
    "enabled": true,
    "bpfPath": ""
  },
  "landlock": {
    "_doc": "Landlock: allowlist de filesystem dentro do sandbox. Habilite apenas em kernels >= 5.13 (ABI >= 1). ABI 3 recomendada (>= 6.2) — inclui suporte a TRUNCATE.",
    "_fail_closed": "Se required:true e o kernel não suportar a ABI mínima, a execução é bloqueada.",
    "enabled": true,
    "required": true,
    "minAbi": 3
  },
  "profiles": {
    "_doc": "Perfis de isolamento. workspace de fetch/quarantine é SEMPRE 'none' (invariante — não há como liberar acesso ao projeto nesses perfis). Perfil normal não deve ser alterado.",
    "fetch": {
      "enabled": true,
      "network": true,
      "ssh": "none"
    },
    "quarantine": {
      "enabled": true,
      "network": false,
      "ssh": "none"
    }
  }
}
